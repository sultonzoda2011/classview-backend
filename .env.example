PORT=5990
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classview

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# фронтенд (через запятую)
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP: нужен App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="ClassView <your@gmail.com>"

# часовой пояс для окна доступа родителей (startTime/endTime)
APP_TIMEZONE=Asia/Dushanbe

# первый SuperAdmin (npm run seed)
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PHONE=+992000000000
SEED_SUPERADMIN_PASSWORD=ChangeMe123

SWAGGER=true
